#!/usr/bin/env bash
set -euo pipefail

FORMAT_PREFIX="ssh-agent-crypt:v3:"
NAMESPACE="ssh-agent-crypt"
LEGACY_NAMESPACE="file"

usage() {
  cat <<USAGE
Usage:
  $0 [key]            < plaintext > encrypted
  $0 -decrypt [key]   < encrypted > plaintext

Key can be:
  - path to a key file
  - key comment (e.g. "user@host")
  - SHA256 fingerprint
  - MD5 fingerprint
  - omitted -> SSH_AGENT_CRYPT_KEY, VAUTH_USER_IDENTITY, VAUTH_USER_MAIL,
               else first key from ssh-agent

Notes:
  - Encryption: AES-256-CBC + HMAC-SHA256
  - Format:
      ssh-agent-crypt:v3:<fingerprint>.<salt_b64>.<iv_hex>.<ciphertext_b64>.<mac_hex>
    (v2 and v1 payloads remain readable)
USAGE
  exit 1
}

fail() {
  echo "$*" >&2
  exit 1
}

MODE=encrypt
KEY=
KEY_FILE=

case "${1:-}" in
  -decrypt)
    MODE=decrypt
    KEY="${2:-}"
    ;;
  -*)
    usage
    ;;
  *)
    KEY="${1:-}"
    ;;
esac

# A missing key argument falls back to the environment (same syntax):
# SSH_AGENT_CRYPT_KEY, then the vauth identity variables. An embedded
# fingerprint still wins when decrypting v2/v3 payloads.
DEFAULT_KEY="${SSH_AGENT_CRYPT_KEY:-${VAUTH_USER_IDENTITY:-${VAUTH_USER_MAIL:-}}}"

classify_key() {
  local first_line
  if [ -n "$KEY" ] && [ -f "$KEY" ]; then
    IFS= read -r first_line < "$KEY" || true
    case "$first_line" in
      ssh-*|ecdsa-sha2-*|sk-ssh-*|sk-ecdsa-*) ;;
      *) KEY_FILE="$KEY" ;;
    esac
  fi
}

get_agent_keys() {
  ssh-add -L
}

resolve_key() {
  local input="$KEY" lookup keys line sha256 md5

  [ -n "$KEY_FILE" ] && return
  [ -n "$input" ] && [ -f "$input" ] && { cat "$input"; return; }

  keys=$(get_agent_keys) || fail "Unable to list ssh-agent keys"
  [ -n "$keys" ] || fail "No keys in ssh-agent"
  [ -z "$input" ] && { printf '%s\n' "$keys" | head -n1; return; }

  lookup=${input#MD5:}
  lookup=${lookup//:/}

  while IFS= read -r line; do
    [[ "$line" = *" $input" ]] && { printf '%s\n' "$line"; return; }
    sha256=$(printf '%s\n' "$line" | ssh-keygen -lf /dev/stdin | awk '{print $2}')
    md5=$(printf '%s\n' "$line" | ssh-keygen -E md5 -lf /dev/stdin | awk '{print $2}')
    [ "$sha256" = "$input" ] || [ "$md5" = "$input" ] || [ "${md5//:/}" = "MD5$lookup" ] || continue
    printf '%s\n' "$line"
    return
  done <<< "$keys"

  fail "Key not found: $input"
}

check_algo() {
  local algo key_info
  if [ -n "$KEY_FILE" ]; then
    # -l can inspect encrypted OpenSSH keys without unlocking them. Signing
    # may still use the agent, or ssh-keygen's existing passphrase prompt.
    # A regular input descriptor avoids ssh-keygen preferring a stale .pub
    # sibling; do not pipe the private key (the reader needs to seek).
    key_info=$(ssh-keygen -lf /dev/stdin < "$KEY_FILE") || fail "Unable to inspect key file: $KEY_FILE"
    case "${key_info##* }" in
      '(RSA)') algo=ssh-rsa ;;
      '(ED25519)') algo=ssh-ed25519 ;;
      '(ECDSA)') algo="ecdsa-sha2-nistp${key_info%% *}" ;;
      *) algo="${key_info##* }" ;;
    esac
  else
    algo=$(printf '%s\n' "$1" | awk '{print $1}')
  fi

  case "$algo" in
    ssh-rsa|rsa-sha2-256|rsa-sha2-512|ssh-ed25519) ;;
    ecdsa-sha2-*) fail "Unsupported key type: $algo (ECDSA signatures are not stable here)" ;;
    *) fail "Unsupported key type: $algo" ;;
  esac
}

# derive_keys <salt_b64> <pubkey> <namespace>
derive_keys() {
  local material source namespace="$3"

  source="from ssh-agent"
  [ -n "$KEY_FILE" ] && source="from key file: $KEY_FILE"
  material=$(
    if [ -n "$KEY_FILE" ]; then
      printf '%s' "$1" | ssh-keygen -Y sign -f /dev/fd/3 -n "$namespace" 3< "$KEY_FILE" 2>/dev/null
    else
      printf '%s' "$1" | ssh-keygen -Y sign -f <(printf '%s\n' "$2") -n "$namespace" 2>/dev/null
    fi |
      awk '/BEGIN SSH SIGNATURE/{f=1;next}/END SSH SIGNATURE/{f=0}f' |
      tr -d '\n' |
      openssl base64 -d -A |
      openssl dgst -sha512 -hex -r |
      awk '{print $1}'
  ) || fail "Unable to derive key material $source"

  printf '%s %s\n' \
    "$(printf 'enc:%s' "$material" | openssl dgst -sha256 -hex -r | awk '{print $1}')" \
    "$(printf 'mac:%s' "$material" | openssl dgst -sha256 -hex -r | awk '{print $1}')"
}
encrypt() {
  local salt_b64 iv_hex enc_key mac_key ciphertext_b64 mac fingerprint payload pubkey keys input_b64

  # Read upstream completely before contacting the agent; keep binary input in memory.
  input_b64=$(openssl base64 -A)

  [ -n "$KEY" ] || KEY="$DEFAULT_KEY"
  classify_key
  pubkey=$(resolve_key)
  check_algo "$pubkey"
  if [ -n "$KEY_FILE" ]; then
    fingerprint=$(ssh-keygen -lf /dev/stdin < "$KEY_FILE" | awk '{print $2}')
  else
    fingerprint=$(printf '%s\n' "$pubkey" | ssh-keygen -lf /dev/stdin | awk '{print $2}')
  fi

  salt_b64=$(openssl rand -base64 32 | tr -d '\n')
  iv_hex=$(openssl rand -hex 16 | tr -d '\n')
  keys=$(derive_keys "$salt_b64" "$pubkey" "$NAMESPACE") || fail "Unable to derive encryption keys"
  read -r enc_key mac_key <<< "$keys"

  ciphertext_b64=$(printf '%s' "$input_b64" | openssl base64 -d -A |
    openssl enc -aes-256-cbc -K "$enc_key" -iv "$iv_hex" -nosalt -base64 -A)
  payload="$fingerprint.$salt_b64.$iv_hex.$ciphertext_b64"
  mac=$(printf '%s%s' "$FORMAT_PREFIX" "$payload" |
    openssl dgst -sha256 -mac HMAC -macopt "hexkey:$mac_key" -hex -r |
    awk '{print $1}')

  printf '%s%s.%s\n' "$FORMAT_PREFIX" "$payload" "$mac"
}

decrypt() {
  local line rest salt_b64 iv_hex ciphertext_b64 mac enc_key mac_key expected_mac payload fingerprint pubkey keys namespace authenticated

  read -r line || fail "Missing payload"
  case "$line" in
    "$FORMAT_PREFIX"*)
      rest=${line#"$FORMAT_PREFIX"}
      namespace="$NAMESPACE"
      authenticated="$FORMAT_PREFIX"
      ;;
    ssh-agent-crypt:v2:*)
      rest=${line#ssh-agent-crypt:v2:}
      namespace="$LEGACY_NAMESPACE"
      authenticated=
      ;;
    ssh-agent-crypt:v1:*)
      rest=${line#ssh-agent-crypt:v1:}
      namespace="$LEGACY_NAMESPACE"
      authenticated=
      ;;
    *) fail "Unsupported format header" ;;
  esac
  payload=${rest%.*}
  case "$line" in
    ssh-agent-crypt:v1:*)
      [ -n "$KEY" ] || KEY="$DEFAULT_KEY"
      ;;
    *)
      fingerprint=${rest%%.*}
      [[ "$fingerprint" =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]] || fail "Invalid key fingerprint"
      [ -n "$KEY" ] || KEY="$fingerprint"
      rest=${rest#*.}
      ;;
  esac

  classify_key
  pubkey=$(resolve_key)
  check_algo "$pubkey"

  salt_b64=${rest%%.*}
  rest=${rest#*.}
  [ "$rest" != "$salt_b64" ] || fail "Missing IV"
  iv_hex=${rest%%.*}
  rest=${rest#*.}
  [ "$rest" != "$iv_hex" ] || fail "Missing ciphertext"
  ciphertext_b64=${rest%.*}
  mac=${rest##*.}
  [ "$ciphertext_b64" != "$rest" ] || fail "Missing MAC"

  keys=$(derive_keys "$salt_b64" "$pubkey" "$namespace") || fail "Unable to derive encryption keys"
  read -r enc_key mac_key <<< "$keys"
  expected_mac=$(printf '%s%s' "$authenticated" "$payload" |
    openssl dgst -sha256 -mac HMAC -macopt "hexkey:$mac_key" -hex -r |
    awk '{print $1}')
  [ "$expected_mac" = "$mac" ] || fail "Authentication failed"

  printf '%s' "$ciphertext_b64" |
    openssl enc -d -aes-256-cbc -K "$enc_key" -iv "$iv_hex" -nosalt -base64 -A
}

case "$MODE" in
  encrypt) encrypt ;;
  decrypt) decrypt ;;
esac
